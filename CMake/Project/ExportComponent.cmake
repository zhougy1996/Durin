include_guard(GLOBAL)
function(durin_generate_export_component)
    if(NOT DURIN_RUNTIME_VARIANT STREQUAL "DurinEditor")
        return()
    endif()
    get_target_property(_runtime DurinAssetTool RUNTIME_OUTPUT_DIRECTORY)
    set(_generator "${CMAKE_SOURCE_DIR}/Engine/Scripts/Build/export_component.py")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${_generator}" "${CMAKE_SOURCE_DIR}/CMakePresets.json"
        "${CMAKE_SOURCE_DIR}/Tools/DurinDevTool/durin_dev_tool/build/config_io.py"
        "${CMAKE_SOURCE_DIR}/Tools/DurinDevTool/durin_dev_tool/build/selection.py")
    execute_process(COMMAND "${Python_EXECUTABLE}" "${_generator}" --generate-backend
        --engine "${CMAKE_SOURCE_DIR}/Engine" --runtime "${_runtime}" --cmake "${CMAKE_COMMAND}"
        --output "${CMAKE_BINARY_DIR}/ExportBackend.json" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Cannot generate declared Game product sets")
    endif()
    if(NOT WIN32)
        return()
    endif()
    # Linked dependencies plus explicitly declared dynamic providers, never all DLL targets.
    set(_queue DurinExportTool DurinAssetTool)
    get_target_property(_providers DurinAssetTool MANUALLY_ADDED_DEPENDENCIES)
    list(APPEND _queue ${_providers})
    get_property(_projects GLOBAL PROPERTY DURIN_GAME_PROJECTS)
    foreach(_project IN LISTS _projects)
        if(NOT _project STREQUAL "Engine")
            get_property(_roots GLOBAL PROPERTY "DURIN_GAME_ROOTS_${_project}")
            list(APPEND _queue ${_roots})
        endif()
        get_property(_catalog GLOBAL PROPERTY "DURIN_PLUGIN_CATALOG_${_project}")
        if(_catalog)
            file(READ "${_catalog}" _json)
            string(JSON _count LENGTH "${_json}" Modules)
            if(_count GREATER 0)
                math(EXPR _last "${_count}-1")
                foreach(_i RANGE ${_last})
                    string(JSON _host GET "${_json}" Modules ${_i} Host)
                    if(_host STREQUAL "Runtime")
                        string(JSON _module GET "${_json}" Modules ${_i} Name)
                        list(APPEND _queue "${_module}")
                    endif()
                endforeach()
            endif()
        endif()
    endforeach()
    set(_visited)
    set(_targets)
    while(_queue)
        list(POP_FRONT _queue _target)
        durin_normalize_target_alias(_target "${_target}")
        if(_target IN_LIST _visited)
            continue()
        endif()
        list(APPEND _visited "${_target}")
        durin_get_target_link_dependencies(_linked "${_target}")
        get_target_property(_dynamic "${_target}" DURIN_DYNAMIC_DEPENDENCIES)
        if(_dynamic)
            list(APPEND _queue ${_dynamic})
        endif()
        list(APPEND _queue ${_linked})
        get_target_property(_type "${_target}" TYPE)
        if(_type STREQUAL "EXECUTABLE" OR _type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
            list(APPEND _targets "${_target}")
        endif()
    endwhile()
    set(_recipe "${CMAKE_COMMAND}\n")
    foreach(_target IN LISTS _targets)
        string(APPEND _recipe "$<TARGET_FILE:${_target}>\n")
        get_target_property(_imported "${_target}" IMPORTED)
        if(NOT _imported)
            string(APPEND _recipe "$<JOIN:$<TARGET_RUNTIME_DLLS:${_target}>,\n>\n")
        endif()
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/ExportComponent.inputs" CONTENT "${_recipe}")
    add_custom_target(ExportComponent ALL
        COMMAND "${Python_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/Engine/Scripts/Build/export_component.py"
            --recipe "${CMAKE_BINARY_DIR}/ExportComponent.inputs" --backend "${CMAKE_BINARY_DIR}/ExportBackend.json" --runtime "${_runtime}"
            --engine "${CMAKE_SOURCE_DIR}/Engine" --compatibility "${DURIN_COOK_COMPATIBILITY}"
            --abi "${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}-${CMAKE_SIZEOF_VOID_P}"
        DEPENDS ${_visited}
        VERBATIM)
endfunction()
