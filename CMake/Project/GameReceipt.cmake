include_guard(GLOBAL)

function(durin_register_game_project name descriptor roots)
    set_property(GLOBAL APPEND PROPERTY DURIN_GAME_PROJECTS "${name}")
    set_property(GLOBAL PROPERTY "DURIN_GAME_DESCRIPTOR_${name}" "${descriptor}")
    set_property(GLOBAL PROPERTY "DURIN_GAME_ROOTS_${name}" "${roots}")
endfunction()

# Dynamic edges are build/receipt edges, never linker dependencies. Aggregate
# receipt targets avoid cycles such as Engine -> Renderer -> Engine.
function(durin_generate_game_receipts)
    if(NOT DURIN_RUNTIME_VARIANT STREQUAL "DurinGame" OR NOT WIN32)
        return()
    endif()
    if(NOT CMAKE_BUILD_TYPE MATCHES "^(Debug|Release)$")
        return()
    endif()
    string(REPLACE "\\" "/" _compiler "${CMAKE_CXX_COMPILER}")
    if(NOT _compiler MATCHES "/MSVC/([0-9.]+)/bin/")
        message(FATAL_ERROR "Win64 Game receipts require the explicit MSVC runtime toolset version")
    endif()
    set(_crt_minimum "${CMAKE_MATCH_1}.0")
    get_property(_projects GLOBAL PROPERTY DURIN_GAME_PROJECTS)
    foreach(_project IN LISTS _projects)
        get_property(_descriptor GLOBAL PROPERTY "DURIN_GAME_DESCRIPTOR_${_project}")
        get_property(_roots GLOBAL PROPERTY "DURIN_GAME_ROOTS_${_project}")
        get_property(_catalog GLOBAL PROPERTY "DURIN_PLUGIN_CATALOG_${_project}")
        set(_queue DurinLauncher ${_roots})
        if(_catalog)
            file(READ "${_catalog}" _json)
            string(JSON _count LENGTH "${_json}" Modules)
            if(_count GREATER 0)
                math(EXPR _last "${_count}-1")
                foreach(_i RANGE ${_last})
                    string(JSON _module GET "${_json}" Modules ${_i} Name)
                    list(APPEND _queue "${_module}")
                endforeach()
            endif()
        endif()
        set(_visited)
        set(_dependencies)
        set(_spec "${DURIN_ENGINE_VERSION_STRING}\n${DURIN_TARGET_PLATFORM}\n${CMAKE_SYSTEM_PROCESSOR}\n$<CONFIG>\n${DURIN_RUNTIME_VARIANT}\n${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}-${CMAKE_SIZEOF_VOID_P}\n${_project}\n")
        string(APPEND _spec "crt\t${_crt_minimum}\ncompat\t${DURIN_COOK_COMPATIBILITY}\n")
        while(_queue)
            list(POP_FRONT _queue _target)
            if(NOT TARGET "${_target}")
                message(FATAL_ERROR "Missing declared runtime module ${_target}")
            endif()
            durin_normalize_target_alias(_target "${_target}")
            if(_target IN_LIST _visited)
                continue()
            endif()
            list(APPEND _visited "${_target}")
            string(MAKE_C_IDENTIFIER "${_target}" _id)
            get_target_property(_owner "${_target}" DURIN_DEPLOY_OWNER)
            if(NOT _owner)
                set(_owner Engine)
            endif()
            get_target_property(_dynamic "${_target}" DURIN_DYNAMIC_DEPENDENCIES)
            if(NOT _dynamic)
                set(_dynamic)
            endif()
            durin_get_target_link_dependencies(_linked "${_target}")
            set(_linked_ids)
            foreach(_link IN LISTS _linked)
                string(MAKE_C_IDENTIFIER "${_link}" _link_id)
                list(APPEND _linked_ids "${_link_id}")
            endforeach()
            string(APPEND _spec "module\t${_id}\t${_owner}\t${_linked_ids}\t${_dynamic}\n")
            list(APPEND _queue ${_linked} ${_dynamic})
            get_target_property(_type "${_target}" TYPE)
            get_target_property(_imported "${_target}" IMPORTED)
            if(NOT _imported)
                list(APPEND _dependencies "${_target}")
            elseif(NOT _type STREQUAL "INTERFACE_LIBRARY")
                string(APPEND _spec "input\t$<TARGET_FILE:${_target}>\n")
            endif()
            if(_type STREQUAL "EXECUTABLE" OR _type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
                if(_target STREQUAL "DurinLauncher")
                    set(_kind Executable)
                    set(_destination "Binaries/Win64/${_project}.exe")
                else()
                    set(_kind NativeLibrary)
                    set(_destination "Binaries/Win64/$<TARGET_FILE_NAME:${_target}>")
                endif()
                get_target_property(_license "${_target}" DURIN_DEPLOY_LICENSE)
                get_target_property(_provenance "${_target}" DURIN_DEPLOY_PROVENANCE)
                get_target_property(_module_descriptor "${_target}" DURIN_MODULE_DESCRIPTOR)
                if(NOT _module_descriptor AND NOT _target STREQUAL "DurinLauncher" AND NOT _license)
                    message(FATAL_ERROR "Redistributed native target ${_target} needs license/provenance declarations")
                endif()
                if(NOT _license)
                    set(_license "")
                    set(_provenance "")
                endif()
                string(APPEND _spec "product\t${_id}\t${_kind}\t$<TARGET_FILE:${_target}>\t${_destination}\t${_license}\t${_provenance}\n")
            endif()
            get_target_property(_files "${_target}" DURIN_DECLARED_RUNTIME_FILES)
            if(_files)
                foreach(_file IN LISTS _files)
                    string(REPLACE "|" "\t" _file "${_file}")
                    string(APPEND _spec "file\t${_id}\t${_file}\n")
                endforeach()
            endif()
            # Native inputs include headers, generated products and target metadata;
            # source edits invalidate reuse even when an old binary is still present.
            get_target_property(_source_dir "${_target}" SOURCE_DIR)
            get_target_property(_sources "${_target}" SOURCES)
            if(EXISTS "${_source_dir}/CMakeLists.txt")
                string(APPEND _spec "input\t${_source_dir}/CMakeLists.txt\n")
            endif()
            if(_sources)
                foreach(_source IN LISTS _sources)
                    if(NOT _source MATCHES "\\$<")
                        cmake_path(ABSOLUTE_PATH _source BASE_DIRECTORY "${_source_dir}" NORMALIZE OUTPUT_VARIABLE _input)
                        if(EXISTS "${_input}")
                            string(APPEND _spec "input\t${_input}\n")
                        endif()
                    endif()
                endforeach()
            endif()
            get_target_property(_metadata "${_target}" DURIN_MODULE_DESCRIPTOR)
            if(_metadata)
                string(APPEND _spec "input\t${_metadata}\n")
            endif()
        endwhile()
        if(_catalog)
            string(APPEND _spec "input\t${_catalog}\n")
        endif()
        string(APPEND _spec "input\t${DURIN_WORKSPACE_DIR}/CMakeLists.txt\ninput\t${DURIN_WORKSPACE_DIR}/CMakePresets.json\ninput\t${CMAKE_BINARY_DIR}/CMakeCache.txt\ninput\t${DURIN_WORKSPACE_DIR}/Durin.dworkspace\ninput\t${DURIN_DHT_TOOL_FINGERPRINT_FILE}\ninput\t${DURIN_WORKSPACE_DIR}/Engine/Scripts/Build/target_receipt.py\n")
        string(APPEND _spec "input\t${_descriptor}\ninput\t${DURIN_WORKSPACE_DIR}/Engine/Engine.dproject\n")
        file(GLOB_RECURSE _build_rules CONFIGURE_DEPENDS "${DURIN_WORKSPACE_DIR}/CMake/*.cmake" "${DURIN_WORKSPACE_DIR}/Engine/CMake/*.cmake")
        foreach(_rule IN LISTS _build_rules)
            string(APPEND _spec "input\t${_rule}\n")
        endforeach()
        set(_root "${CMAKE_BINARY_DIR}/TargetReceipts/${_project}/$<CONFIG>")
        file(GENERATE OUTPUT "${_root}/Build.inputs" CONTENT "${_spec}")
        add_custom_target(${_project}GameReceipt ALL
            COMMAND "${Python_EXECUTABLE}" "${DURIN_WORKSPACE_DIR}/Engine/Scripts/Build/target_receipt.py"
                --inputs "${_root}/Build.inputs" --workspace "${DURIN_WORKSPACE_DIR}"
                --artifacts "${CMAKE_BINARY_DIR}" --project "${_descriptor}" --catalog "${_catalog}"
                --output "${_root}/TargetReceipt.json"
            DEPENDS ${_dependencies}
            BYPRODUCTS "${_root}/TargetReceipt.json"
            COMMENT "Publishing completed ${_project} Game receipt"
            VERBATIM)
    endforeach()
endfunction()
