include_guard(GLOBAL)

function(durin_register_plugin_catalog project catalog_file)
	set_property(GLOBAL APPEND PROPERTY DURIN_PLUGIN_PROJECTS "${project}")
	set_property(GLOBAL PROPERTY "DURIN_PLUGIN_CATALOG_${project}" "${catalog_file}")
endfunction()

# All workspace targets exist before inventories resolve their native closure.
function(durin_generate_plugin_builds)
	get_property(_projects GLOBAL PROPERTY DURIN_PLUGIN_PROJECTS)
	foreach(_project IN LISTS _projects)
		get_property(_catalog_file GLOBAL PROPERTY "DURIN_PLUGIN_CATALOG_${_project}")
		file(READ "${_catalog_file}" _catalog)
		string(FIND "${_catalog}" "\"Plugin/" _plugin_input)
		if(_plugin_input EQUAL -1)
			continue()
		endif()
		string(JSON _count LENGTH "${_catalog}" Modules)
		set(_binaries "")
		set(_native_targets)
		if(TARGET Core)
			list(APPEND _native_targets Core)
		endif()
		if(_count GREATER 0)
			math(EXPR _last "${_count}-1")
			foreach(_index RANGE ${_last})
				string(JSON _module GET "${_catalog}" Modules ${_index} Name)
				string(JSON _owner GET "${_catalog}" Modules ${_index} Owner)
				durin_collect_target_dependency_closure(_closure "${_module}")
				set(_dependencies)
				foreach(_target IN LISTS _closure)
					get_target_property(_type "${_target}" TYPE)
					if(_type STREQUAL "SHARED_LIBRARY" OR _type STREQUAL "MODULE_LIBRARY")
						list(APPEND _native_targets "${_target}")
						if(NOT _target STREQUAL _module)
							list(APPEND _dependencies "${_target}")
						endif()
					endif()
				endforeach()
				string(APPEND _binaries "${_module}\t${_owner}\t${_dependencies}\n")
			endforeach()
		endif()
		list(REMOVE_DUPLICATES _native_targets)
		set(_files "")
		set(_build_inputs)
		foreach(_target IN LISTS _native_targets)
			string(APPEND _files "${_target}\t$<TARGET_FILE:${_target}>\n")
			get_target_property(_imported "${_target}" IMPORTED)
			if(_imported)
				list(APPEND _build_inputs "$<TARGET_FILE:${_target}>")
			else()
				list(APPEND _build_inputs "${_target}")
			endif()
		endforeach()
		set(_root "${CMAKE_BINARY_DIR}/PluginBuild/${_project}/$<CONFIG>")
		set(_spec "${_root}/Inventory.inputs")
		file(GENERATE OUTPUT "${_spec}" CONTENT "${DURIN_ENGINE_VERSION_STRING}\n${DURIN_TARGET_PLATFORM}\n${CMAKE_SYSTEM_PROCESSOR}\n$<CONFIG>\n${DURIN_RUNTIME_VARIANT}\n${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}-${CMAKE_SIZEOF_VOID_P}\n${_binaries}---\n${_files}")
		set(_script "${DURIN_WORKSPACE_DIR}/Engine/Scripts/Build/plugin_inventory.py")
		set(_output "${_root}/PluginBuild.json")
		set(_depfile "${_root}/Inventory.d")
		add_custom_command(OUTPUT "${_output}"
			COMMAND "${Python_EXECUTABLE}" "${_script}"
				--catalog "${_catalog_file}" --inputs "${_spec}" --output "${_root}" --depfile "${_depfile}"
			DEPENDS ${_build_inputs} "${_catalog_file}" "${_spec}" "${_script}"
			DEPFILE "${_depfile}"
			COMMENT "Publishing ${_project} plugin build inventory"
			VERBATIM)
		add_custom_target(${_project}PluginBuild ALL DEPENDS "${_output}")
	endforeach()
endfunction()
