#!/bin/sh

REPOSITORY_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
VENV_PYTHON="$REPOSITORY_ROOT/.venv/bin/python"
ENTRY_POINT="$REPOSITORY_ROOT/Tools/DurinDevTool/durin_dev_tool/__main__.py"

if [ -x "$VENV_PYTHON" ]; then
    exec "$VENV_PYTHON" "$ENTRY_POINT" "$@"
fi

for PYTHON_NAME in python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
    if PYTHON_COMMAND=$(command -v "$PYTHON_NAME" 2>/dev/null); then
        if "$PYTHON_COMMAND" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)'; then
            exec "$PYTHON_COMMAND" "$ENTRY_POINT" "$@"
        fi
    fi
done

echo "Python 3.10 or newer was not found." >&2
echo "Install Python 3.10 or newer, then rerun DevTool." >&2
exit 1
