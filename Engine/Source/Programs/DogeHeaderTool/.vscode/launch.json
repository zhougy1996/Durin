    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "--module", "Engine",
            ]
        },
        {
            "name": "Test build tool",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "get_module_dirs", "-p", "d:/Studyspace/Doge/Engine/Engine.dproject",
            ]
        }
    ]
}