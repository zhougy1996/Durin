{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "durin-plugin-selection.schema.json",
  "title": "Durin portable plugin selection v1",
  "type": "object", "additionalProperties": false,
  "required": ["SchemaVersion", "Platform", "RuntimeVariant", "Plugins", "Modules", "Inputs", "Fingerprint"],
  "properties": {
    "SchemaVersion": {"const": 1},
    "Platform": {"type": "string", "minLength": 1},
    "RuntimeVariant": {"enum": ["DurinEditor", "DurinGame"]},
    "Plugins": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["Id", "Reasons"],
      "properties": {
        "Id": {"type": "string", "minLength": 1},
        "Reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "Modules": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["Name", "Owner", "Host", "Phase"],
      "properties": {
        "Name": {"type": "string", "minLength": 1},
        "Owner": {"type": "string", "minLength": 1},
        "Host": {"enum": ["Runtime", "Editor"]},
        "Phase": {"enum": ["Providers", "EngineReady", "EditorReady"]}
      }
    }},
    "Inputs": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["Path", "Hash"],
      "properties": {
        "Path": {"type": "string", "minLength": 1},
        "Hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    }},
    "Fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
  }
}
