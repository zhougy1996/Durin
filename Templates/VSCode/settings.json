{
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/Build/Win64-Debug-DurinEditor",
    "--background-index"
  ],
  "json.schemas": [
    {
      "fileMatch": ["*.dworkspace"],
      "url": "./Engine/Source/Programs/DurinHeaderTool/schemas/durin-workspace.schema.json"
    },
    {
      "fileMatch": ["*.dproject"],
      "url": "./Engine/Source/Programs/DurinHeaderTool/schemas/durin-project.schema.json"
    },
    {
      "fileMatch": ["*.dmodule"],
      "url": "./Engine/Source/Programs/DurinHeaderTool/schemas/durin-module.schema.json"
    }
  ],
  "cmake.configureOnOpen": false,
  "cmake.configureOnEdit": false,
  "cmake.automaticReconfigure": false,
  "cmake.buildBeforeRun": false
}
