{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-migration-v2.schema.json",
  "title": "Durin asset migration report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operation", "result", "packages", "summary", "changedPaths"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "operation": { "enum": ["Plan", "Apply"] },
    "result": { "enum": ["Ready", "Succeeded", "Blocked", "Failed", "Cancelled", "RolledBack"] },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/package" } },
    "summary": { "$ref": "#/$defs/summary" },
    "changedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileSize", "lastWriteTimeTicks", "contentHash"],
      "properties": {
        "fileSize": { "type": "integer", "minimum": 0 },
        "lastWriteTimeTicks": { "type": "integer" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handlerId", "kind", "sourceVersion", "targetVersion", "sourceCodecId", "targetCodecId", "strategy", "risk"],
      "properties": {
        "handlerId": { "type": "string", "minLength": 1 },
        "kind": { "const": "PackageFormat" },
        "sourceVersion": { "type": "integer", "minimum": 0 },
        "targetVersion": { "type": "integer", "minimum": 0 },
        "sourceCodecId": { "type": "string", "minLength": 1 },
        "targetCodecId": { "type": "string", "minLength": 1 },
        "strategy": { "const": "LoadTransformWrite" },
        "risk": { "enum": ["Lossless", "DataLoss", "Unknown"] }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packagePath", "physicalPath", "status", "fingerprint", "sourceFormatVersion", "targetFormatVersion", "readerPolicyFingerprint", "steps", "diagnostics"],
      "properties": {
        "packagePath": { "type": "string", "minLength": 1 },
        "physicalPath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["Planned", "Migrated", "Skipped", "Blocked", "Failed", "RolledBack"] },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "sourceFormatVersion": { "type": "integer", "minimum": 0 },
        "targetFormatVersion": { "type": "integer", "minimum": 0 },
        "readerPolicyFingerprint": { "type": "integer", "minimum": 0 },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned", "migrated", "skipped", "blocked", "failed", "rolledBack"],
      "properties": {
        "planned": { "type": "integer", "minimum": 0 },
        "migrated": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "rolledBack": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
