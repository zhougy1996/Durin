{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "status", "code", "diagnostic", "target", "profile",
    "changedBytes", "reusedBytes", "peakCapturedBytes", "rangeReadCount", "wallTimeNanoseconds",
    "commitTimeNanoseconds", "rollbackTimeNanoseconds", "packages"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "status": {"enum": ["succeeded", "failed", "cancelled"]},
    "code": {"type": "string"},
    "diagnostic": {"type": "string"},
    "target": {"enum": ["win64", "macos"]},
    "profile": {"const": "game"},
    "changedBytes": {"type": "integer", "minimum": 0},
    "reusedBytes": {"type": "integer", "minimum": 0},
    "peakCapturedBytes": {"type": "integer", "minimum": 0},
    "rangeReadCount": {"type": "integer", "minimum": 0},
    "wallTimeNanoseconds": {"type": "integer", "minimum": 0},
    "commitTimeNanoseconds": {"type": "integer", "minimum": 0},
    "rollbackTimeNanoseconds": {"type": "integer", "minimum": 0},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packagePath", "serializer", "status", "stage", "code",
          "diagnostic", "packageBytes", "segmentBytes"
        ],
        "properties": {
          "packagePath": {"type": "string"},
          "serializer": {"type": "string"},
          "status": {
            "oneOf": [
              {"enum": ["cook-hit", "captured", "omitted", "failed", "cancelled"]},
              {
                "enum": ["ddc-hit", "rebuilt", "reused-output", "unsupported"],
                "deprecated": true,
                "description": "Accepted for older v2 reports only; current package reports do not emit build-operation outcomes."
              }
            ]
          },
          "stage": {"enum": ["discovery", "load", "prepare", "capture", "stage-segment", "stage-package", "commit-segment", "commit-package", "commit-state", "commit-manifest", "rollback", "stale-cleanup", "writer-lock"]},
          "code": {"type": "string"},
          "diagnostic": {"type": "string"},
          "packageBytes": {"type": "integer", "minimum": 0},
          "segmentBytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
